# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=visitor_assistance

# Redis Configuration (Optional - fallback to in-memory if not available)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Africa's Talking API Configuration
AT_USERNAME=your_username
AT_API_KEY=your_api_key
AT_USSD_CODE=*384*1234#

# Location Services Configuration
OPENCELLID_API_KEY=your_opencellid_key
OPENCAGE_API_KEY=your_opencage_key

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure

# Voice Configuration
VOICE_CALLBACK_URL=https://yourdomain.com/voice
VOICE_CALLER_ID=+234XXXXXXXXX

# USSD Configuration
USSD_CALLBACK_URL=https://yourdomain.com/ussd/callback

# SMS Configuration
SMS_SENDER_ID=VISITOR

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Visitor Assist <noreply@visitorassist.com>

# Support Configuration
SUPPORT_PHONE=+234800VISITOR
SUPPORT_EMAIL=support@visitorassist.com

# Dashboard URLs (for email links)
OWNER_DASHBOARD_URL=https://yourdomain.com/owner/dashboard
ADMIN_DASHBOARD_URL=https://yourdomain.com/admin/dashboard